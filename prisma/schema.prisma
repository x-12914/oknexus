// Prisma schema for the CryptX exchange.
// Provider is Postgres for production; a docker-compose is included for local dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth / Auth.js v5) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  kycStatus     KycStatus @default(NONE)
  kycLegalName  String?
  kycCountry    String?
  kycIdNumber   String?
  kycReviewedAt DateTime?
  twoFAEnabled  Boolean   @default(false)
  twoFASecret   String? // encrypted TOTP secret (AES-256-GCM)
  tokenVersion  Int       @default(0) // bump to invalidate all existing sessions ("sign out everywhere")
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  wallets  Wallet[]
  orders   Order[]
  trades   Trade[]

  ledgerEntries LedgerEntry[]
  swaps         SwapTx[]
  ramps         RampTx[]
  otcTrades     OtcTrade[]
  p2pOrders     P2POrder[]
  p2pAds        P2PAd[]
  loginEvents   LoginEvent[]
  notifications Notification[]
  priceAlerts   PriceAlert[]
  stakes        StakePosition[]
  kycSessions   KycSession[]

  depositAddresses    DepositAddress[]
  deposits            Deposit[]
  withdrawals         Withdrawal[]
  ngnAccount          NgnAccount?
  fiatDeposits        FiatDeposit[]
  fiatPayouts         FiatPayout[]
  withdrawalAddresses WithdrawalAddress[]
  /// When on, withdrawals may only go to whitelisted addresses.
  whitelistOnly       Boolean             @default(false)
  /// Shown in every email we send, so a user can tell our mail from a phish.
  antiPhishingCode    String?
  apiKeys             ApiKey[]
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

/// A hosted identity-verification session with a provider (Didit) — links the
/// provider's session id back to our user and tracks the latest reported status.
model KycSession {
  id        String   @id @default(cuid())
  userId    String
  provider  String // "didit"
  sessionId String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVIEW // passed automated checks but flagged (e.g. AML hit) — needs manual EDD
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Wallets ----------

model Asset {
  symbol   String  @id
  name     String
  decimals Int     @default(8)
  isFiat   Boolean @default(false)
  network  String?
  contract String?
  logoUrl  String?

  wallets      Wallet[]
  baseMarkets  Market[] @relation("BaseAsset")
  quoteMarkets Market[] @relation("QuoteAsset")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  balance   Decimal  @default(0) @db.Decimal(30, 10)
  locked    Decimal  @default(0) @db.Decimal(30, 10)
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [symbol], references: [symbol])

  @@unique([userId, symbol])
}

// ---------- Trading ----------

model Market {
  id           String  @id @default(cuid())
  symbol       String  @unique
  baseSymbol   String
  quoteSymbol  String
  minOrderSize Decimal @default(0) @db.Decimal(30, 10)
  tickSize     Decimal @default(0.01) @db.Decimal(30, 10)
  stepSize     Decimal @default(0.00000001) @db.Decimal(30, 10)
  makerFee     Decimal @default(0.001) @db.Decimal(10, 6)
  takerFee     Decimal @default(0.002) @db.Decimal(10, 6)
  isActive     Boolean @default(true)

  base   Asset   @relation("BaseAsset", fields: [baseSymbol], references: [symbol])
  quote  Asset   @relation("QuoteAsset", fields: [quoteSymbol], references: [symbol])
  orders Order[]
  trades Trade[]
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP // stop-market: triggers a market order when the stop price is hit
  STOP_LIMIT // stop-limit: places a limit order when the stop price is hit
}

enum OrderStatus {
  PENDING // stop order waiting for its trigger price
  OPEN
  PARTIAL
  FILLED
  CANCELLED
  REJECTED
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  marketId     String
  side         OrderSide
  type         OrderType
  price        Decimal?    @db.Decimal(30, 10)
  triggerPrice Decimal?    @db.Decimal(30, 10) // stop/trigger price for STOP & STOP_LIMIT
  quantity     Decimal     @db.Decimal(30, 10)
  filledQty    Decimal     @default(0) @db.Decimal(30, 10)
  avgFillPrice Decimal?    @db.Decimal(30, 10)
  status       OrderStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  market Market  @relation(fields: [marketId], references: [id])
  trades Trade[]

  @@index([marketId, status])
  @@index([userId, createdAt])
}

model Trade {
  id        String    @id @default(cuid())
  marketId  String
  orderId   String
  userId    String
  side      OrderSide
  price     Decimal   @db.Decimal(30, 10)
  quantity  Decimal   @db.Decimal(30, 10)
  fee       Decimal   @default(0) @db.Decimal(30, 10)
  feeSymbol String?
  createdAt DateTime  @default(now())

  market Market @relation(fields: [marketId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([marketId, createdAt])
  @@index([userId, createdAt])
}

// ---------- Ledger (immutable journal over wallet balances) ----------
//
// Every balance movement writes one LedgerEntry per (wallet, account) leg with a
// signed delta and the resulting balance. A single operation (e.g. a swap) writes
// multiple entries sharing a refId. Wallet.balance / Wallet.locked are the running
// totals these entries reconcile to.

enum LedgerAccount {
  AVAILABLE
  LOCKED
}

enum LedgerType {
  SEED
  SWAP
  RAMP
  SPOT
  OTC
  P2P
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  STAKE
  ADJUSTMENT
}

model LedgerEntry {
  id           String        @id @default(cuid())
  userId       String
  symbol       String
  account      LedgerAccount @default(AVAILABLE)
  delta        Decimal       @db.Decimal(30, 10)
  balanceAfter Decimal       @db.Decimal(30, 10)
  type         LedgerType
  refId        String? // groups the legs of one operation
  memo         String?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([refId])
}

// ---------- Persisted trade history ----------

model SwapTx {
  id         String   @id @default(cuid())
  userId     String
  fromSymbol String
  toSymbol   String
  fromAmount Decimal  @db.Decimal(30, 10)
  toAmount   Decimal  @db.Decimal(30, 10)
  rate       Decimal  @db.Decimal(30, 10)
  feeSymbol  String?
  feeAmount  Decimal  @default(0) @db.Decimal(30, 10)
  status     String   @default("FILLED")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RampTx {
  id            String    @id @default(cuid())
  userId        String
  side          OrderSide
  fiatCode      String
  cryptoSymbol  String
  fiatAmount    Decimal   @db.Decimal(30, 10)
  totalFiat     Decimal   @db.Decimal(30, 10)
  cryptoAmount  Decimal   @db.Decimal(30, 10)
  paymentMethod String
  status        String    @default("COMPLETED")
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OtcTrade {
  id             String    @id @default(cuid())
  userId         String
  side           OrderSide
  baseSymbol     String
  settleCurrency String
  baseAmount     Decimal   @db.Decimal(30, 10)
  price          Decimal   @db.Decimal(30, 10)
  totalCost      Decimal   @db.Decimal(30, 10)
  status         String    @default("FILLED")
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- P2P (persisted escrow trades) ----------

enum P2POrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
  DISPUTED
}

model P2POrder {
  id                   String         @id @default(cuid())
  userId               String
  advertiserId         String? // the ad's advertiser (another real user); null for seeded mock ads
  adId                 String
  asset                String
  fiat                 String
  price                Decimal        @db.Decimal(30, 10)
  assetAmount          Decimal        @db.Decimal(30, 10)
  fiatAmount           Decimal        @db.Decimal(30, 10)
  paymentMethod        String
  status               P2POrderStatus @default(PENDING_PAYMENT)
  takerRole            String // "buyer" | "seller"
  buyerName            String
  sellerName           String
  merchantId           String
  merchant             Json // merchant snapshot for display
  paymentWindowMinutes Int
  escrowLocked         Boolean        @default(false)
  /// P2P fee taken from the buyer's proceeds, in `asset`. Covers escrow and
  /// dispute-resolution overhead rather than being a pure margin.
  fee                  Decimal        @default(0) @db.Decimal(30, 10)
  createdAt            DateTime       @default(now())
  expiresAt            DateTime
  completedAt          DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages P2PMessage[]

  @@index([userId, createdAt])
}

model P2PMessage {
  id        String   @id @default(cuid())
  orderId   String
  sender    String // "buyer" | "seller" | "system"
  text      String
  createdAt DateTime @default(now())

  order P2POrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model P2PAd {
  id             String    @id @default(cuid())
  advertiserId   String? // null = seeded mock ad
  side           OrderSide // advertiser's action: SELL = they sell crypto; BUY = they buy
  asset          String
  fiat           String
  price          Decimal   @db.Decimal(30, 10)
  available      Decimal   @db.Decimal(30, 10) // asset units still open (locked for SELL ads)
  minLimit       Decimal   @db.Decimal(30, 10) // fiat
  maxLimit       Decimal   @db.Decimal(30, 10) // fiat
  paymentMethods String[]
  terms          String?
  merchantName   String
  merchant       Json // P2PMerchant snapshot for display
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  advertiser User? @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([side, asset, fiat, active])
  @@index([advertiserId])
}

// ---------- Custody (on-chain deposits & withdrawals) ----------
//
// Per-user deposit addresses are derived from one HD seed (BIP-44). A background
// scanner credits the ledger on confirmed deposits; withdrawals lock funds, sign
// & broadcast from a hot wallet, then settle on confirmation. Testnet today
// (Sepolia/testnet endpoints); flips to mainnet by config.

model ChainState {
  chain            String   @id // "ethereum-sepolia"
  lastScannedBlock BigInt   @default(0)
  nextIndex        Int      @default(1) // HD address index; 0 is the hot wallet
  updatedAt        DateTime @updatedAt
}

model DepositAddress {
  id              String   @id @default(cuid())
  userId          String
  chain           String
  address         String
  derivationIndex Int
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain])
  @@unique([chain, derivationIndex])
  @@index([address])
}

/// Successful sign-in events, powering the account's login history / device list.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// In-app notifications (bell/feed): deposits, withdrawals, transfers, security events.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // DEPOSIT | WITHDRAWAL | TRANSFER | SECURITY | TRADE | SYSTEM
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// User-set price alerts: notify when an asset crosses a target price (USD).
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String // base asset, e.g. "BTC"
  direction   String // ABOVE | BELOW
  target      Decimal   @db.Decimal(30, 10)
  triggered   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  triggeredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([triggered])
  @@index([userId, createdAt])
}

/// Flexible-staking positions: principal locked in the ledger, rewards accrue at an APY.
model StakePosition {
  id          String    @id @default(cuid())
  userId      String
  symbol      String // staked asset, e.g. "ETH"
  principal   Decimal   @db.Decimal(30, 10)
  apy         Decimal   @db.Decimal(10, 4) // annual % at stake time
  accrued     Decimal   @default(0) @db.Decimal(30, 10) // rewards accrued so far, in the staked asset
  status      String    @default("ACTIVE") // ACTIVE | CLOSED
  createdAt   DateTime  @default(now())
  lastAccrued DateTime  @default(now()) // cursor for incremental reward accrual
  closedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

enum DepositStatus {
  PENDING // seen on-chain, awaiting confirmations
  CREDITED // confirmed and credited to the ledger
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  chain         String
  symbol        String
  amount        Decimal       @db.Decimal(30, 10)
  address       String
  txHash        String
  blockNumber   BigInt
  confirmations Int           @default(0)
  status        DepositStatus @default(PENDING)
  creditedAt    DateTime?
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, txHash, symbol, address])
  @@index([userId, createdAt])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING_APPROVAL // over the dual-control threshold; needs a second person
  REQUESTED // funds locked, awaiting broadcast
  BROADCAST // signed & sent, awaiting confirmations
  CONFIRMED // on-chain confirmed, funds settled out
  FAILED // rejected/failed; funds returned to available
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  chain      String
  symbol     String
  amount     Decimal          @db.Decimal(30, 10)
  fee        Decimal          @default(0) @db.Decimal(30, 10)
  toAddress  String
  txHash     String?
  status     WithdrawalStatus @default(REQUESTED)
  /// Dual control: whoever approved this must not be whoever requested it.
  approvedBy String?
  approvedAt DateTime?
  error      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// ---------- Fiat off-ramp (crypto -> local bank, via a payout provider) ----------

/// Lifecycle of a provider payout. Mirrors Withdrawal: funds are LOCKED at
/// request and only leave the account once the provider accepts, so a failure
/// before hand-off can refund without ever having debited.
enum FiatPayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

model FiatPayout {
  id               String           @id @default(cuid())
  userId           String
  provider         String           @default("bitnob")
  /// Provider quote id (e.g. "QT2_123"); the handle we initialize/finalize against.
  providerQuoteId  String?
  /// Unique: the provider's payout uuid is our idempotency key, so a
  /// double-submitted quote hits a constraint instead of paying twice.
  providerPayoutId String?          @unique
  fromSymbol       String
  fromAmount       Decimal          @db.Decimal(30, 10)
  fiatCode         String
  fiatAmount       Decimal          @db.Decimal(30, 10)
  effectiveRate    Decimal          @db.Decimal(30, 10)
  /// Provider margin in fiat, derived from the rate spread (their fee field is always 0).
  feeFiat          Decimal          @default(0) @db.Decimal(30, 10)
  /// OKNexus margin, charged on top of the provider's spread, in fromSymbol.
  platformFee      Decimal          @default(0) @db.Decimal(30, 10)
  country          String
  bankCode         String
  bankName         String
  accountNumber    String
  /// Holder name as resolved by the provider, not as typed by the user.
  accountName      String?
  status           FiatPayoutStatus @default(REQUESTED)
  /// Raw status last reported by the provider, kept verbatim so an
  /// unrecognised value can be inspected instead of guessed at.
  providerStatus   String?
  error            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

/// Immutable record of privileged actions.
///
/// Role-based access control says who *may* act; it does not record who *did*.
/// For a platform holding customer funds the second question is the one that
/// matters after the fact, so every admin action and approval lands here.
model AuditLog {
  id         String   @id @default(cuid())
  /// Who performed it. Null only for system-initiated actions.
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  /// Free-form context: amounts, before/after values, reason.
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

/// Saved withdrawal destinations.
///
/// Two controls in one: restricting withdrawals to known addresses, and a delay
/// before a newly added one can be used. The delay is the part that actually
/// defeats session hijacking — an attacker who gets in can add an address, but
/// cannot drain to it before the owner notices.
model WithdrawalAddress {
  id         String   @id @default(cuid())
  userId     String
  chain      String
  address    String
  label      String
  /// Usable only from this moment. Set on creation, never shortened.
  activeFrom DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain, address])
  @@index([userId])
}

/// A user's programmatic access key.
///
/// Only a hash is stored. The plaintext is shown once at creation and cannot be
/// recovered — a key we can display on demand is a key an attacker can read out
/// of our database.
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  label       String
  /// SHA-256 of the full key.
  keyHash     String    @unique
  /// First few characters, so a user can tell their keys apart.
  prefix      String
  /// AES-256-GCM signing secret. Encrypted rather than hashed because HMAC
  /// verification needs the original value back; a hash would make signing
  /// impossible. Shown to the user exactly once, at creation.
  secretEnc   String?
  /// Read-only by default; trading and withdrawal are opt-in.
  canTrade    Boolean   @default(false)
  canWithdraw Boolean   @default(false)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Current state of one monitored condition.
///
/// One row per check, updated in place. Alerts fire on TRANSITIONS — healthy to
/// firing, and back again — because a check that notifies every minute while a
/// condition persists is noise, and noise is how the CoinGecko outage went
/// unnoticed for weeks.
model SystemAlert {
  /// Stable check id, e.g. "provider:bitnob" or "float:low".
  key        String    @id
  severity   String
  title      String
  detail     String
  firing     Boolean   @default(true)
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  resolvedAt DateTime?
  /// Last time we told anyone, so a long outage re-notifies rather than going quiet.
  notifiedAt DateTime?

  @@index([firing, severity])
}

/// A user's dedicated NGN account number at the payout provider.
///
/// One per user, because an incoming bank transfer carries nothing that
/// identifies the sender as one of our users — the account it landed in is the
/// only reliable attribution. Deliberately holds no BVN: that is passed
/// straight through to the provider at provisioning time and never persisted,
/// so a breach here cannot leak one.
model NgnAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  bitnobCustomerId String
  bitnobAccountId  String   @unique
  accountNumber    String   @unique
  bankName         String
  accountName      String
  reference        String   @unique
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountNumber])
}

/// Money that arrived over the bank rail.
///
/// Separate from Deposit, which is on-chain and identified by a transaction
/// hash. Keyed on the provider's transaction id so a repeated poll credits
/// once — the poller has no other way to tell a re-read from a new payment.
model FiatDeposit {
  id            String    @id @default(cuid())
  /// Null when the money landed in an account we cannot attribute. That is the
  /// whole reason this column is nullable: an unowned deposit is precisely the
  /// case a human needs to resolve, so it has to be storable.
  userId        String?
  providerTxId  String    @unique
  currency      String
  amount        Decimal   @db.Decimal(30, 10)
  fee           Decimal   @default(0) @db.Decimal(30, 10)
  /// RECEIVED | CREDITED | HELD | REFUNDED
  status        String    @default("RECEIVED")
  accountNumber String
  reference     String?
  /// Why a deposit is sitting in HELD, for the admin who has to resolve it.
  holdReason    String?
  valueDate     String?
  creditedAt    DateTime?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}
