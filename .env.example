# Database
DATABASE_URL="postgresql://cryptx:cryptx@localhost:5432/cryptx?schema=public"

# Auth.js
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"

# Social sign-in (all optional, all independent).
#
# A provider's button only appears on /login and /register once BOTH its id and
# secret are set here, so leaving a pair blank simply hides it. Register this
# callback URL with each provider (swap in localhost:3000 for local dev):
#
#   https://oknexusexchange.com/api/auth/callback/<provider>
#
# e.g. .../api/auth/callback/google. Either naming convention works —
# AUTH_GOOGLE_ID or the older GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple needs a paid developer account, an HTTPS callback (no localhost), and a
# client secret that is a JWT expiring every 6 months — regenerate with
# `npx auth add apple`.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
COINBASE_CLIENT_ID=""
COINBASE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# X/Twitter only returns an email address with elevated API access. Because it
# never says whether that address is verified, X and Discord sign-ins are not
# auto-linked to an existing account with the same email (see src/lib/social-auth.ts).
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Exchange connector (binance | mock). binance = live public market data with
# automatic fallback to mock if the API is unreachable/geo-blocked.
EXCHANGE_CONNECTOR="binance"
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# KYC provider (stub | didit). Didit is selected automatically once configured.
KYC_PROVIDER="stub"
# Didit hosted identity verification. Results arrive on a signed webhook.
DIDIT_API_KEY=""
DIDIT_WEBHOOK_SECRET=""
# Full verification: document + selfie + AML. The only route that unlocks fiat.
DIDIT_WORKFLOW_ID=""
# Basic verification: name + NIN matched against the NIMC register, no document.
# Optional. The Basic tier is offered only when this is set. Crypto only.
DIDIT_BASIC_WORKFLOW_ID=""
# BVN verification: BVN + selfie face-matched to the bank's portrait, no document.
# Optional. Counts as full verification (unlocks fiat) when set.
DIDIT_BVN_WORKFLOW_ID=""
# Server-side sanctions/PEP screening (Didit standalone AML, $0.20) for any
# fiat-unlocking approval whose workflow had no AML step. On unless "false".
KYC_SERVER_AML="true"

# Rolling-24h withdrawal caps in USD, per verification tier.
LIMIT_UNVERIFIED_USD="200"
LIMIT_BASIC_USD="500"
WITHDRAW_DAILY_USD_LIMIT="2000"

# Bitnob fiat on/off-ramp (NGN & Africa).
# HMAC-SHA256 auth against ONE base URL for both environments — sandbox and
# production share BITNOB_CLIENT_ID and differ only in the secret key, so going
# live is a key swap (sk_test_… -> sk_live_…), not a URL change.
BITNOB_CLIENT_ID=""
BITNOB_SECRET_KEY=""   # colon-prefixed, e.g. prd:live:… (production)
# BITNOB_API_BASE=""   # optional override, defaults to https://api.bitnob.com

# Live payouts move real money and are OFF unless explicitly enabled.
BITNOB_ALLOW_LIVE_PAYOUTS="false"
# While testing, restrict who can execute one. REQUIRED as long as new accounts
# are seeded with demo USDT (see src/lib/assets.ts) — otherwise anyone who
# registers can convert demo balance into real naira until the float is drained.
BITNOB_PAYOUT_ALLOWLIST=""

# Give new accounts demo balances (src/lib/assets.ts). MUST stay off wherever
# live payouts are enabled — otherwise registering is a way to convert demo
# balance into real money up to the provider float.
ENABLE_DEMO_SEED="false"
# Warn admins when the payout provider float drops below this (stablecoin units).
BITNOB_FLOAT_MIN="5"

# The legacy simulated fiat ramp settles to REAL internal balances with an
# imaginary fiat leg. MUST stay off wherever payouts are live.
ENABLE_SIMULATED_RAMP="false"

# The legacy simulated fiat ramp settles to REAL internal balances with an
# imaginary fiat leg. MUST stay off wherever payouts are live.
ENABLE_SIMULATED_RAMP="false"

# Staking rewards are minted, not funded. Keep off until yield comes from a real
# treasury. Gates entering a stake only — unstaking always works.
ENABLE_EARN="false"

# Require an APPROVED identity check before fiat leaves the platform.
# Defaults to true when unset — a money control should fail restrictive.
PAYOUT_REQUIRE_KYC="true"
# Who may execute payouts: comma-separated emails, or "*" for everyone.
# Unset/empty means NOBODY.
BITNOB_PAYOUT_ALLOWLIST=""

# Bitcoin network for the BTC adapter: "mainnet" or "testnet" (default). Solana
# follows SOL_RPC_URL: a mainnet endpoint switches the adapter to mainnet-beta.
BTC_NETWORK="testnet"
# SOL_RPC_URL="https://api.mainnet-beta.solana.com"

# Fiat on-ramps (card / bank / mobile money -> crypto to the user's own deposit
# address). Each provider is dark until its keys are set and fails closed without them.
ALCHEMYPAY_APP_ID=""
ALCHEMYPAY_APP_SECRET=""
ALCHEMYPAY_ENV="production"   # or "sandbox"
ONRAMPER_API_KEY=""
# Ed25519 private key (PEM) registered with Onramper, base64-encoded to fit one
# line: base64 -w0 onramper.pem. Signs the wallet address so it cannot be changed.
ONRAMPER_SIGNING_KEY_B64=""
ONRAMPER_WEBHOOK_SECRET=""
# Optional overrides of the fiat lists offered per provider (comma-separated).
# ALCHEMYPAY_FIATS="NGN,USD,EUR,GBP"
# ONRAMPER_FIATS="NGN,USD,EUR,GBP"

# Custody chains offered to users: comma-separated "evm","sol","btc". EVM only
# by default — Solana and Bitcoin adapters are pinned to devnet/testnet and must
# not be offered beside a mainnet chain (identical addresses, unscanned network).
CUSTODY_CHAINS="evm"
# REAL FUNDS. Selects viem mainnet + mainnet.infura.io + etherscan, and raises
# the confirmation default to 12. Requires a mainnet-capable INFURA_API_KEY and
# a hot wallet funded with real ETH for gas.
EVM_NETWORK="sepolia"

# Dual control: withdrawals at or above this USD value wait for a second person
# to approve. 0 disables approval. RBAC alone means one compromised admin can
# drain the treasury; a different human approving is what actually stops that.
WITHDRAW_APPROVAL_USD="1000"
