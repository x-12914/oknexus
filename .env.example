# Database
DATABASE_URL="postgresql://cryptx:cryptx@localhost:5432/cryptx?schema=public"

# Auth.js
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Exchange connector (binance | mock). binance = live public market data with
# automatic fallback to mock if the API is unreachable/geo-blocked.
EXCHANGE_CONNECTOR="binance"
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# KYC provider (stub | sumsub | jumio)
KYC_PROVIDER="stub"
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""

# Bitnob fiat on/off-ramp (NGN & Africa).
# HMAC-SHA256 auth against ONE base URL for both environments — sandbox and
# production share BITNOB_CLIENT_ID and differ only in the secret key, so going
# live is a key swap (sk_test_… -> sk_live_…), not a URL change.
BITNOB_CLIENT_ID=""
BITNOB_SECRET_KEY=""   # colon-prefixed, e.g. prd:live:… (production)
# BITNOB_API_BASE=""   # optional override, defaults to https://api.bitnob.com
